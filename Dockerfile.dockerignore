# Keeps the build fast and keeps secrets out of the image.
#
# Paths are relative to the build context, which for this Dockerfile is the
# PARENT folder (cfcapp/) — so entries are written as cfc-*/… not as bare names.

**/node_modules
**/.git
**/.env
**/.env.*
**/.next
**/.next-*
**/.turbo
**/*.log

# Locally uploaded documents and photos. These belong in a volume on the
# server, never baked into an image.
cfc-backend/uploads
