# Copy to .env — .env is gitignored and must stay that way.

NODE_ENV=development
PORT=4000

# MongoDB Atlas. Use an application user scoped to this one database, not the
# cluster admin. Rotate anything that has been pasted into a chat or a ticket.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/cfc?appName=Cluster0

# Signs every session token. Any long random string; rotating it signs everyone
# out. Generate with: openssl rand -base64 48
JWT_SECRET=

# Encrypts pro bank account numbers at rest. Kept separate from JWT_SECRET so
# rotating the session key does not make stored bank details undecryptable.
# LOSING THIS MEANS EVERY PRO MUST RE-ENTER THEIR BANK DETAILS. Back it up.
# Generate with: openssl rand -base64 48
BANK_ENCRYPTION_KEY=

# The super admin. Exists as configuration rather than a database record
# because it has to exist before anyone can create anything.
SUPER_ADMIN_EMAIL=admin@cfcservice.in
SUPER_ADMIN_PASSWORD=

# OTP delivery is dummied until the client's DLT templates are registered.
# The flow is real regardless: codes are generated, hashed, expired and rate
# limited. This only decides whether the master code below is also accepted.
# Boot refuses to start with this true and NODE_ENV=production.
AUTH_DUMMY_OTP=true
AUTH_MASTER_OTP=123456

# Where uploaded images are written. Defaults to ./uploads next to the server.
# KYC documents go to a sibling directory that is never served statically.
UPLOAD_ROOT=

# Browser origins allowed to call the API — the three Next apps.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Google Maps, server side — reverse geocoding only.
#
# A SECOND key, separate from the browser's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY:
# restrict this one to the Geocoding API and to this server's IP, and never
# ship it to a browser. Leave it empty and the address form falls back to
# typed entry instead of the map lookup.
GOOGLE_MAPS_SERVER_KEY=

# Which geocoder turns a map pin into an address: osm (default) or google.
#
# `osm` costs nothing and needs no billing account. `google` needs an ACTIVATED
# billing account — in India that means a one-off Rs 1,000 prepayment before a
# single request is served. Switching is this value plus a restart.
GEOCODER=osm

# Optional, for the osm geocoder. Without it, public Nominatim is used: free and
# needs no signup, but limited to about one request a second and its policy does
# not cover commercial use. With it, Geoapify serves the same OSM data under
# commercial terms, ~3000 requests/day free, no card.
# Free key: https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
